  "components": {
    "schemas": {
      "CreateMovieRequest": {
        "required": [
          "title",
          "language",
          "genre"
        ],
        "type": "object",
        "properties": {
          "title": {
            "maxLength": 150,
            "minLength": 0,
            "type": "string"
          },
          "description": {
            "maxLength": 500,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ]
          },
          "durationMinutes": {
            "maximum": 2147483647,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "releaseDate": {
            "type": "string",
            "format": "date-time"
          },
          "language": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "genre": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "CreateScreenRequest": {
        "required": [
          "screenName"
        ],
        "type": "object",
        "properties": {
          "theatreId": {
            "maximum": 2147483647,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "screenName": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "CreateSeatRequest": {
        "required": [
          "rowName",
          "seatType"
        ],
        "type": "object",
        "properties": {
          "screenId": {
            "maximum": 2147483647,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "rowName": {
            "maxLength": 5,
            "minLength": 0,
            "type": "string"
          },
          "seatNumber": {
            "maximum": 2147483647,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "seatType": {
            "maxLength": 30,
            "minLength": 0,
            "type": "string"
          }
        }
      },
      "CreateShowRequest": {
        "type": "object",
        "properties": {
          "movieId": {
            "maximum": 2147483647,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "screenId": {
            "maximum": 2147483647,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "startTime": {
            "type": "string",
            "format": "date-time"
          },
          "endTime": {
            "type": "string",
            "format": "date-time"
          },
          "ticketPrice": {
            "maximum": 99999999.99,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "CreateTheatreRequest": {
        "required": [
          "name",
          "location"
